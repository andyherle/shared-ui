{
  "name": "@andyherle/shared-ui",
  "version": "1.10.2",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Shared native UI controls with Postvisual and Personal style packs.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "audit": "node scripts/audit-consumers.mjs",
    "studio": "node scripts/studio.mjs",
    "studio:editor": "node scripts/studio-server.mjs",
    "studio:mcp": "node tools/studio-mcp/server.mjs",
    "studio:mcp:check": "npm --prefix tools/studio-mcp test",
    "studio:browser": "node test/serve-studio.mjs",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "review:managed": "node scripts/review-launcher.mjs",
    "review:owners": "node scripts/review-owners.mjs"
